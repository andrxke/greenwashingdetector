# EcoClaim Auditor - AI inference configuration
#
# The app works fully out of the box with ZERO configuration: if these
# variables are left unset, /api/audit automatically uses the built-in
# deterministic heuristic auditor instead of calling an external LLM.
#
# To enable real LLM-powered analysis, point these at any OpenAI-compatible
# chat-completions endpoint. Both Baseten and Modal deployments commonly
# expose this format.
#
# --- Baseten example ---
# AI_ENDPOINT_URL=https://model-xxxxxxx.api.baseten.co/environments/production/sync/v1/chat/completions
# AI_API_KEY=your-baseten-api-key
# AI_MODEL=your-deployed-model-name
#
# --- Modal example ---
# AI_ENDPOINT_URL=https://your-workspace--your-app-chat-completions.modal.run/v1/chat/completions
# AI_API_KEY=your-modal-api-key
# AI_MODEL=your-deployed-model-name
#
# --- OpenAI example (useful for local testing) ---
# AI_ENDPOINT_URL=https://api.openai.com/v1/chat/completions
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini

AI_ENDPOINT_URL=
AI_API_KEY=
AI_MODEL=
